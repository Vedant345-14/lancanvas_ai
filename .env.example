# ---- Network ----
PORT=8000
# 0.0.0.0 = reachable from other devices on your LAN. Use 127.0.0.1 to keep it private to this computer.
HOST=0.0.0.0

# ---- Storage (relative paths resolve from the project root) ----
DATABASE_PATH=./data/lancanvas.db
UPLOAD_DIR=./uploads

# ---- Security ----
# Leave blank to auto-generate a random secret saved in data/.session_secret.
# Or generate your own:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# ---- AI notes (optional; the whiteboard works without these) ----
# Any OpenAI-compatible chat-completions API works (OpenAI, OpenRouter, Groq, Ollama, LM Studio, ...)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Set to false if your model cannot read images
AI_VISION=true
